PORT=8000
AI_API_KEY=dev-secret-key-change-in-production
LOG_LEVEL=INFO
MODEL_NAME=all-MiniLM-L6-v2
# Path to fine-tuned model checkpoint if available (e.g. models/custom-sif-minilm)
CUSTOM_MODEL_PATH=models/custom-sif-minilm
# Multimodal Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_PROVIDER=gemini
# Language translation: set to false to disable Hindi→English translation
TRANSLATION_ENABLED=true
